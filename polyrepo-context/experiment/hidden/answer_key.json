{
  "_note": "SYNTHETIC answer key for DP-1423. Kept off the trial branches until every trial was scored.",
  "repositories": {
    "code_change": ["platform-contracts", "ingestion-service", "metadata-service",
                    "platform-sdk", "entitlements-service", "consumption-gateway",
                    "transformation-service", "search-indexer", "platform-e2e"],
    "verify_only": ["lineage-service"],
    "not_impacted": ["notification-service", "usage-metering", "reporting-service"]
  },
  "relevant_edges": [
    ["ingestion-service", "metadata-service", "ingestion.schema.discovered.v1"],
    ["metadata-service", "entitlements-service", "columns API / metadata.dataset.changed.v1"],
    ["metadata-service", "transformation-service", "GET /v1/datasets/{urn}/columns"],
    ["metadata-service", "search-indexer", "metadata.dataset.changed.v1 (strict)"],
    ["metadata-service", "lineage-service", "metadata.dataset.changed.v1 (tolerant)"],
    ["entitlements-service", "consumption-gateway", "POST /v1/access/decide"],
    ["platform-sdk", "entitlements-service", "MetadataClient"],
    ["platform-sdk", "transformation-service", "MetadataClient"],
    ["platform-sdk", "consumption-gateway", "EntitlementsClient"],
    ["platform-contracts", "platform-sdk", "pinned contracts release"],
    ["platform-contracts", "search-indexer", "vendored schema"]
  ],
  "contracts": [
    {"id": "C1", "kind": "event", "match": "ingestion.schema.discovered"},
    {"id": "C2", "kind": "event", "match": "metadata.dataset.changed"},
    {"id": "C3", "kind": "http", "method": ["GET"], "path_regex": "^/v1/datasets/[^/]+/columns$"},
    {"id": "C4", "kind": "http", "method": ["PUT", "PATCH", "POST"], "path_regex": "classif", "owner": "metadata-service"},
    {"id": "C5", "kind": "http", "method": ["POST"], "path_regex": "^/v1/access/decide$"}
  ]
}

{
  "$id": "metadata.dataset.changed.v1",
  "$comment": "Synthetic contract for a controlled experiment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "urn",
    "change",
    "owner",
    "columns"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "metadata.dataset.changed"
      ]
    },
    "urn": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "tags"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "PII"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "txn-pipeline/transaction_event.schema.json",
  "title": "Transaction event (Kafka message emulated as one JSON Lines record)",
  "type": "object",
  "required": ["offset", "value"],
  "properties": {
    "offset": {"type": "integer", "minimum": 0},
    "key": {"type": ["string", "null"]},
    "timestamp": {"type": "integer", "description": "producer time, epoch millis"},
    "value": {
      "type": "object",
      "required": ["transaction_id", "customer_id", "amount", "currency",
                   "event_time", "merchant_id"],
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "amount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"type": "string"},
        "event_time": {"type": "string", "format": "date-time"},
        "merchant_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
